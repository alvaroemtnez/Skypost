<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Scan QR codes in the app (CameraX + ZXing, no Google services). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Receive audio from the radio's USB sound card. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- GNSS: position for "Estoy bien" and UTC time for JS8 slot sync off-grid. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ rejects a FINE request that does not also ask for COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keep listening/transmitting with the screen off (phase 2 service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SkypostApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skypost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Skypost.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open the app when the radio is plugged in (skips the permission prompt next time). -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
            <!-- skypost: codes (contacts, Pharos, groups) opened from the camera app or a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skypost" />
            </intent-filter>
        </activity>

    </application>
</manifest>
