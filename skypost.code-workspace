{
  "folders": [
    { "name": "skypost (root)", "path": "." },
    { "name": "core (Rust)", "path": "core" },
    { "name": "android (Kotlin)", "path": "android" },
    { "name": "prototype (Python)", "path": "prototype" }
  ],
  "settings": {
    "rust-analyzer.linkedProjects": ["core/Cargo.toml"],
    "rust-analyzer.check.command": "clippy",
    "files.exclude": {
      "**/target": true,
      "**/.gradle": true,
      "**/build": true,
      "**/__pycache__": true
    },
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder:prototype (Python)}"
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "tamasfe.even-better-toml",
      "fwcd.kotlin",
      "ms-python.python",
      "editorconfig.editorconfig"
    ]
  }
}
